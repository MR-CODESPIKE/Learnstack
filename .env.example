# ==========================================
# LearnStack Environment Variables
# ==========================================

# 1. AI Models (Tutor Chat, Code Review, AI Quiz Generator)
# Gemini API Key (Google AI Studio) - powers gemini-3.6-flash
GEMINI_API_KEY=

# Mistral API Key (Optional) - powers mistral-small and codestral
MISTRAL_API_KEY=

# 2. Database & Authentication (Supabase)
# Project URL from Supabase Project Settings -> API
VITE_SUPABASE_URL=

# Project Anon public key from Supabase Project Settings -> API
VITE_SUPABASE_ANON_KEY=

# 3. Media & Storage (Optional)
# Hugging Face Access Token for study room media upload (/api/hf-upload)
HF_TOKEN=

# Hugging Face Dataset repository (e.g. username/repo-name)
HF_DATASET_REPO=

